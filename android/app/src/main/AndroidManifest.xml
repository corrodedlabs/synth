<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vulkan 1.1: Apsis runs on 1.1 and 1.2 phones too, through its fallback. Play can't tell which
         of those have the features the table needs, so the app checks at launch and shows phones
         it can't serve a "Play in browser" screen (GameActivity). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <!-- Finding a browser for "Play in browser": Android 11 and later hide other apps otherwise. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application
        android:name=".SynthApp"
        android:label="28"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">
        <activity
            android:name=".GameActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:screenOrientation="fullSensor"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Invite links. Android asks which app to use until respawnfi.com vouches for this one in
                 /.well-known/assetlinks.json; autoVerify makes it check. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="synth28" android:host="join" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="respawnfi.com" />
            </intent-filter>
        </activity>
    </application>
</manifest>
