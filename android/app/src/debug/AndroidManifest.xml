<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds may talk to a plain ws:// server on the test machine. -->
    <application android:usesCleartextTraffic="true">
        <receiver android:name=".DebugBridge" android:exported="true">
            <intent-filter>
                <action android:name="dev.synth.app.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
