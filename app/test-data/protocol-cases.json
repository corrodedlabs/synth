{
  "about": "Server frames and what they decode to, shared by app/src/net/protocol.shared.test.ts and android/core/src/test/kotlin/dev/synth/core/SharedProtocolCasesTest.kt. 'wire' is the text frame. 'expected' is the decoded ServerEvent as plain JSON: '_tag' plus the event's fields under their TypeScript names; suits and ranks as their TS strings; seat maps as objects keyed by the seat as a string; absent optional fields left out; null for a frame that decodes to nothing. 'webExpected', when present, replaces 'expected' for the web client only: it covers messages the Android client knows and the web client deliberately does not. Disconnected is the one event with no wire form (the socket raises it), so it has no case.",
  "cases": [
    { "wire": "#<void>", "expected": null },
    { "wire": "   ", "expected": null },

    { "wire": "room-created", "expected": { "_tag": "RoomCreated" } },
    { "wire": "room-joined", "expected": { "_tag": "RoomJoined" } },
    { "wire": "room-left", "expected": { "_tag": "RoomLeft" } },
    { "wire": "(room-closed \"a's table\")", "expected": { "_tag": "RoomClosed" } },
    { "wire": "(removed-from-room \"a's table\")", "expected": { "_tag": "RemovedFromRoom" } },
    {
      "wire": "(active-rooms (((host . \"a@x\") (name . \"a's table\") (members \"bot-1\" \"a@x\") (target . 2)) ((host . \"b@x\") (name . \"b's table\") (members \"b@x\"))))",
      "expected": {
        "_tag": "ActiveRooms",
        "rooms": [
          { "host": "a@x", "name": "a's table", "members": ["bot-1", "a@x"], "target": 2 },
          { "host": "b@x", "name": "b's table", "members": ["b@x"], "target": 6 }
        ]
      }
    },
    { "wire": "(active-rooms ())", "expected": { "_tag": "ActiveRooms", "rooms": [] } },
    {
      "wire": "(start-game-failed room-not-ready)",
      "expected": { "_tag": "StartGameFailed", "reason": "room-not-ready" }
    },
    {
      "wire": "(room-members \"r\" (bot-2 bot-1 \"me@x\"))",
      "expected": { "_tag": "RoomMembers", "members": ["bot-2", "bot-1", "me@x"] }
    },
    {
      "wire": "(room-members \"r\" (\"me@x\") 2)",
      "expected": { "_tag": "RoomMembers", "members": ["me@x"], "target": 2 }
    },
    { "wire": "(game-started)", "expected": { "_tag": "GameStarted" } },
    { "wire": "(game-aborted \"a's table\")", "expected": { "_tag": "GameAborted" } },

    {
      "wire": "(hand \"me@x\" (#s(card jack 7 club 3) #s(card ten 4 heart 1)))",
      "expected": {
        "_tag": "HandDealt",
        "cards": [
          { "id": "clubs-J", "suit": "clubs", "rank": "J" },
          { "id": "hearts-10", "suit": "hearts", "rank": "10" }
        ]
      }
    },
    { "wire": "(turn 2)", "expected": { "_tag": "Turn", "playerIndex": 2 } },
    { "wire": "(request-bid 16)", "expected": { "_tag": "BidRequested", "minBid": 16 } },
    { "wire": "(bid-placed 1 17)", "expected": { "_tag": "BidPlaced", "playerIndex": 1, "bid": 17 } },
    { "wire": "(bid-placed 2 pass)", "expected": { "_tag": "BidPlaced", "playerIndex": 2, "bid": "pass" } },
    { "wire": "(bid-result (19 . 1))", "expected": { "_tag": "BidResult", "bid": 19, "playerIndex": 1 } },
    { "wire": "(choose-trump)", "expected": { "_tag": "ChooseTrumpRequested" } },
    { "wire": "(trump-selected)", "expected": { "_tag": "TrumpSelected" } },
    {
      "wire": "(played 3 #s(card eight 1 heart 0))",
      "expected": {
        "_tag": "CardPlayed",
        "playerIndex": 3,
        "card": { "id": "hearts-8", "suit": "hearts", "rank": "8" }
      }
    },
    {
      "wire": "(played 3 expose-trump club)",
      "expected": { "_tag": "TrumpExposed", "playerIndex": 3, "suit": "clubs" }
    },
    {
      "wire": "(play-card (cards-played #s(card ace 5 spade 1)) (game-state (trump-suit . #f) (first-suit . spade)))",
      "expected": {
        "_tag": "PlayRequested",
        "cardsPlayed": [{ "id": "spades-A", "suit": "spades", "rank": "A" }],
        "trumpSuit": null,
        "firstSuit": "spades"
      }
    },
    {
      "wire": "(play-card (cards-played) (game-state (trump-suit . diamond) (first-suit . #f)))",
      "expected": { "_tag": "PlayRequested", "cardsPlayed": [], "trumpSuit": "diamonds", "firstSuit": null }
    },
    {
      "wire": "(points-won #hash((0 . 10) (1 . 10) (2 . 5) (3 . 3)))",
      "expected": { "_tag": "PointsWon", "points": { "0": 10, "1": 10, "2": 5, "3": 3 } }
    },
    {
      "wire": "(hand-result ((hand . 2) (bidder . 1) (bid . 19) (made . #t) (delta . 1) (evens . -2) (odds . 1) (target . 6)))",
      "expected": {
        "_tag": "HandResult",
        "hand": 2, "bidder": 1, "bid": 19, "made": true, "delta": 1, "evens": -2, "odds": 1, "target": 6
      }
    },
    {
      "wire": "(match-over ((winner . odds) (evens . -2) (odds . 6) (hands . 7)))",
      "expected": { "_tag": "MatchOver", "winner": "odds", "evens": -2, "odds": 6, "hands": 7 }
    },

    {
      "wire": "(player-disconnected \"a@x\" 45)",
      "expected": { "_tag": "PlayerDisconnected", "email": "a@x", "graceSeconds": 45 }
    },
    { "wire": "(player-reconnected \"a@x\")", "expected": { "_tag": "PlayerReconnected", "email": "a@x" } },
    { "wire": "(emote-played 2 laugh)", "expected": { "_tag": "EmotePlayed", "seat": 2, "emote": "laugh" } },
    { "wire": "(seat-abandoned 2 \"a@x\")", "expected": { "_tag": "SeatAbandoned", "seat": 2, "email": "a@x" } },
    {
      "wire": "(seat-replaced 2 bot-7 (bot-3 bot-2 bot-7 \"host@x\"))",
      "expected": {
        "_tag": "SeatReplaced",
        "seat": 2,
        "email": "bot-7",
        "members": ["bot-3", "bot-2", "bot-7", "host@x"]
      }
    },
    {
      "wire": "(game-snapshot ((room . my-room) (members \"j3\" \"j2\" \"me@x\" \"host@x\") (your-seat . 2) (hand-number . 2) (evens . -2) (odds . 1) (target . 6) (stage . playing) (high-bid . #f) (bid-result 17 . 1) (trump . #f) (trump-exposed . #f) (your-hand #s(card jack 7 club 3) #s(card seven 0 heart 0)) (trick-leader . 0) (trick (0 . #s(card ace 5 heart 1))) (points (0 . 3) (1 . 0) (2 . 4) (3 . 0)) (tricks (0 . 1) (1 . 0) (2 . 1) (3 . 0)) (last-result . #f) (awaiting . 2) (request play-card (cards-played #s(card ace 5 heart 1)) (game-state (trump-suit . #f) (first-suit . heart)))))",
      "expected": {
        "_tag": "GameSnapshot",
        "snapshot": {
          "room": "my-room",
          "members": ["j3", "j2", "me@x", "host@x"],
          "yourSeat": 2,
          "handNumber": 2,
          "evens": -2,
          "odds": 1,
          "target": 6,
          "stage": "playing",
          "highBid": null,
          "bidResult": { "value": 17, "seat": 1 },
          "trumpSuit": null,
          "trumpExposed": false,
          "yourHand": [
            { "id": "clubs-J", "suit": "clubs", "rank": "J" },
            { "id": "hearts-7", "suit": "hearts", "rank": "7" }
          ],
          "trickLeader": 0,
          "trick": [{ "seat": 0, "card": { "id": "hearts-A", "suit": "hearts", "rank": "A" } }],
          "points": { "0": 3, "1": 0, "2": 4, "3": 0 },
          "tricks": { "0": 1, "1": 0, "2": 1, "3": 0 },
          "lastResult": null,
          "awaiting": 2,
          "request": {
            "_tag": "PlayRequested",
            "cardsPlayed": [{ "id": "hearts-A", "suit": "hearts", "rank": "A" }],
            "trumpSuit": null,
            "firstSuit": "hearts"
          }
        }
      }
    },
    {
      "wire": "(game-snapshot ((room . my-room) (members \"j3\" \"j2\" \"me@x\" \"host@x\") (your-seat . 3) (hand-number . 1) (evens . 1) (odds . 0) (target . 6) (stage . between-hands) (high-bid 16 . 0) (bid-result 16 . 0) (trump . diamond) (trump-exposed . #t) (your-hand) (trick-leader . 3) (trick) (points (0 . 10) (1 . 6) (2 . 9) (3 . 3)) (tricks (0 . 3) (1 . 2) (2 . 2) (3 . 1)) (last-result (hand . 1) (bidder . 0) (bid . 16) (made . #t) (delta . 1) (evens . 1) (odds . 0) (target . 6)) (awaiting . #f) (request . #f)))",
      "expected": {
        "_tag": "GameSnapshot",
        "snapshot": {
          "room": "my-room",
          "members": ["j3", "j2", "me@x", "host@x"],
          "yourSeat": 3,
          "handNumber": 1,
          "evens": 1,
          "odds": 0,
          "target": 6,
          "stage": "between-hands",
          "highBid": { "value": 16, "seat": 0 },
          "bidResult": { "value": 16, "seat": 0 },
          "trumpSuit": "diamonds",
          "trumpExposed": true,
          "yourHand": [],
          "trickLeader": 3,
          "trick": [],
          "points": { "0": 10, "1": 6, "2": 9, "3": 3 },
          "tricks": { "0": 3, "1": 2, "2": 2, "3": 1 },
          "lastResult": {
            "_tag": "HandResult",
            "hand": 1, "bidder": 0, "bid": 16, "made": true, "delta": 1, "evens": 1, "odds": 0, "target": 6
          },
          "awaiting": null,
          "request": null
        }
      }
    },
    { "wire": "(no-running-game)", "expected": { "_tag": "NoRunningGame" } },
    {
      "wire": "(leaderboard ((\"asha\" 3 2) (\"badri\" 3 1)))",
      "expected": {
        "_tag": "Leaderboard",
        "rows": [
          { "name": "asha", "played": 3, "won": 2 },
          { "name": "badri", "played": 3, "won": 1 }
        ]
      }
    },
    { "wire": "(error already-in-match)", "expected": { "_tag": "ServerError", "message": "already-in-match" } },
    {
      "wire": "(error \"bad \\\"quoted\\\" thing\")",
      "expected": { "_tag": "ServerError", "message": "\"bad \\\"quoted\\\" thing\"" }
    },

    {
      "wire": "(protocol-ok 1)",
      "expected": { "_tag": "ProtocolOk", "version": 1 },
      "webExpected": { "_tag": "Ignored", "raw": "(protocol-ok 1)" }
    },
    {
      "wire": "(update-required 2)",
      "expected": { "_tag": "UpdateRequired", "minVersion": 2 },
      "webExpected": { "_tag": "Ignored", "raw": "(update-required 2)" }
    },

    { "wire": "(done)", "expected": { "_tag": "Ignored", "raw": "(done)" } },
    { "wire": "invalid-request", "expected": { "_tag": "Ignored", "raw": "invalid-request" } },
    { "wire": "pong", "expected": { "_tag": "Ignored", "raw": "pong" } },
    { "wire": "(unterminated", "expected": { "_tag": "Ignored", "raw": "(unterminated" } },
    { "wire": "(hand-result ((hand . 1)))", "expected": { "_tag": "Ignored", "raw": "(hand-result ((hand . 1)))" } },
    { "wire": "(match-over ((winner . nobody)))", "expected": { "_tag": "Ignored", "raw": "(match-over ((winner . nobody)))" } },
    { "wire": "(emote-played x laugh)", "expected": { "_tag": "Ignored", "raw": "(emote-played x laugh)" } }
  ]
}
